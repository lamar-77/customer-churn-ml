# Copy this file to .env and fill in your Supabase values.

# Supabase Dashboard -> Connect -> Project URL
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Supabase Dashboard -> Connect -> Publishable key
# This is intentionally the PUBLIC/PUBLISHABLE key, not a secret key.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY_HERE

# Optional local Flask session key.
# Leave blank while developing if you want ChurnSense to generate a random one each run.
CHURNSENSE_SECRET_KEY=

# Keep 1 while developing. Use 0 for a packaged/release build.
CHURNSENSE_DEBUG=1
